@model CareerHub.Models.Kynang

@{
    ViewData["Title"] = "Sửa kỹ năng";
}

<div class="container py-4">

    <h2 class="mb-4">Sửa kỹ năng</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MaKyNang" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="MaKyNang" class="form-label">
                        Mã kỹ năng
                    </label>

                    <input asp-for="MaKyNang"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="TenKyNang" class="form-label">
                        Tên kỹ năng
                    </label>

                    <input asp-for="TenKyNang" class="form-control" />

                    <span asp-validation-for="TenKyNang"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Lưu thay đổi
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>

            </form>

        </div>
    </div>

</div>