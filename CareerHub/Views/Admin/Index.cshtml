@model IEnumerable<CareerHub.Models.Tintuyendung>

@{
    ViewData["Title"] = "Quản lý tin tuyển dụng";
}

<div class="container-fluid py-4">

    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Dashboard Admin</h2>
            <p class="text-muted mb-0">
                Tổng quan và quản lý hoạt động tuyển dụng
            </p>
        </div>
    </div>

    <!-- Các thẻ thống kê -->
    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Tổng tin tuyển dụng</h6>
                    <h2 class="text-primary fw-bold">
                        @ViewBag.TongTinTuyenDung
                    </h2>
                    <p class="mb-0 text-muted">
                        Tổng số tin trong hệ thống
                    </p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Tin chờ duyệt</h6>
                    <h2 class="text-warning fw-bold">
                        @ViewBag.TinChoDuyet
                    </h2>
                    <p class="mb-0 text-muted">
                        Tin cần Admin kiểm tra
                    </p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Tổng số công ty</h6>
                    <h2 class="text-success fw-bold">
                        @ViewBag.TongCongTy
                    </h2>
                    <p class="mb-0 text-muted">
                        Công ty đã đăng ký
                    </p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Lượt ứng tuyển</h6>
                    <h2 class="text-info fw-bold">
                        @ViewBag.TongLuotUngTuyen
                    </h2>
                    <p class="mb-0 text-muted">
                        Tổng lượt ứng tuyển trong hệ thống
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Thông báo -->
    <div id="thongBao"></div>

    <!-- Bảng tin tuyển dụng -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">
                Danh sách tin tuyển dụng chờ duyệt
            </h5>
        </div>

        <div class="card-body">
            <!-- Form tìm kiếm -->
            <form asp-controller="Admin"
                  asp-action="Index"
                  method="get"
                  class="row g-3 mb-4">

                <div class="col-md-8">
                    <input type="text"
                           name="tuKhoa"
                           value="@ViewBag.TuKhoa"
                           class="form-control"
                           placeholder="Nhập tiêu đề tin hoặc tên công ty..." />
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Tìm kiếm
                    </button>
                </div>

                <div class="col-md-2">
                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="btn btn-secondary w-100">
                        Làm mới
                    </a>
                </div>

            </form>

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Mã tin</th>
                            <th>Tiêu đề</th>
                            <th>Công ty</th>
                            <th>Ngày đăng</th>
                            <th>Hạn nộp</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var tin in Model)
                            {
                                <tr data-ma-tin="@tin.MaTin">

                                    <td>@tin.MaTin</td>

                                    <td>
                                        <strong>@tin.TieuDe</strong>
                                    </td>

                                    <td>
                                        @tin.MaCongTyNavigation.TenCongTy
                                    </td>

                                    <td>
                                        @(tin.NgayDang?.ToString("dd/MM/yyyy") ?? "")
                                    </td>

                                    <td>
                                        @(tin.HanNop?.ToString("dd/MM/yyyy") ?? "")
                                    </td>

                                    <td>
                                        <span class="badge bg-warning text-dark trang-thai">
                                            @tin.TrangThai
                                        </span>
                                    </td>

                                    <td class="text-center">

                                        <form class="token-form d-none">
                                            @Html.AntiForgeryToken()
                                        </form>

                                        <button type="button"
                                                class="btn btn-success btn-sm btn-duyet"
                                                data-trang-thai="Đã duyệt">
                                            <i class="bi bi-check-circle"></i>
                                            Duyệt
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm btn-tu-choi"
                                                data-trang-thai="Từ chối">
                                            <i class="bi bi-x-circle"></i>
                                            Từ chối
                                        </button>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <span class="text-muted">
                                        Không có tin tuyển dụng chờ duyệt.
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<script>

    document.querySelectorAll(".btn-duyet, .btn-tu-choi")
        .forEach(function (button) {

            button.addEventListener("click", async function () {

                const dong = button.closest("tr");

                const maTin = dong.dataset.maTin;

                const trangThai = button.dataset.trangThai;

                const token = dong.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value;

                const duLieu = new URLSearchParams();

                duLieu.append("maTin", maTin);
                duLieu.append("trangThai", trangThai);
                duLieu.append("__RequestVerificationToken", token);

                button.disabled = true;

                try {

                    const response = await fetch(
                        "/Admin/CapNhatTrangThai",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded"
                            },

                            body: duLieu
                        }
                    );

                    if (!response.ok) {
                        throw new Error("Lỗi HTTP");
                    }

                    const ketQua = await response.json();

                    const thongBao = document.getElementById("thongBao");

                    if (ketQua.success) {

                        const badge = dong.querySelector(".trang-thai");

                        badge.textContent = ketQua.trangThai;

                        badge.className = "badge trang-thai " +
                            (ketQua.trangThai === "Đã duyệt"
                                ? "bg-success"
                                : "bg-danger");

                        dong.querySelectorAll("button")
                            .forEach(function (btn) {
                                btn.disabled = true;
                            });

                        thongBao.className = "alert alert-success";

                        thongBao.textContent = ketQua.message;

                    }
                    else {

                        button.disabled = false;

                        thongBao.className = "alert alert-danger";

                        thongBao.textContent = ketQua.message;

                    }

                }
                catch (error) {

                    button.disabled = false;

                    const thongBao = document.getElementById("thongBao");

                    thongBao.className = "alert alert-danger";

                    thongBao.textContent =
                        "Có lỗi xảy ra khi cập nhật trạng thái tin tuyển dụng.";

                }

            });

        });

</script>