@model IEnumerable<CareerHub.Models.Tintuyendung>

@{
    ViewData["Title"] = "Trang chủ - Cổng thông tin việc làm CareerHub";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- BANNER TÌM KIẾM HERO SECTION -->
<div class="container-fluid bg-primary mb-5 wow fadeIn" data-wow-delay="0.1s" style="padding: 35px;">
    <div class="container">
        <div class="row g-2 align-items-center">
            <div class="col-md-10">
                <form asp-controller="Jobs" asp-action="Index" method="get" class="row g-2">
                    <div class="col-md-8">
                        <input type="text" name="keyword" class="form-control border-0 py-3" placeholder="Nhập chức danh công việc, tên công ty..." />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-dark border-0 w-100 py-3">
                            <i class="fa fa-search me-2"></i>Tìm kiếm việc làm
                        </button>
                    </div>
                </form>
            </div>
            <div class="col-md-2">
                <a asp-controller="Home" asp-action="FilterByCategory" class="btn btn-outline-light border-2 w-100 py-3">
                    <i class="fa fa-th-large me-1"></i>Việc theo ngành
                </a>
            </div>
        </div>
    </div>
</div>

<!-- DANH SÁCH VIỆC LÀM MỚI NHẤT -->
<div class="container-xxl py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bold mb-1">Cơ Hội Việc Làm Mới Nhất</h2>
                <p class="text-muted mb-0">Khám phá các vị trí tuyển dụng hấp dẫn từ những nhà tuyển dụng hàng đầu</p>
            </div>
            <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary px-4">
                Xem tất cả việc làm <i class="fa fa-arrow-right ms-2"></i>
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fa fa-briefcase fa-3x mb-3 text-secondary"></i>
                <h5>Hiện chưa có tin tuyển dụng nào được đăng tải.</h5>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var job in Model)
                {
                    <div class="col-lg-6">
                        <div class="job-item p-4 border rounded shadow-sm h-100 bg-white">
                            <div class="d-flex align-items-center mb-3">
                                <div>
                                    <h5 class="mb-1 text-primary fw-bold">@job.TieuDe</h5>
                                    <span class="text-muted me-3">
                                        <i class="fa fa-building me-1"></i>@(job.MaCongTyNavigation?.TenCongTy ?? "Công ty tuyển dụng")
                                    </span>
                                </div>
                            </div>
                            <div class="mb-3 text-muted">
                                <span class="me-3">
                                    <i class="fa fa-map-marker-alt text-primary me-1"></i>@(job.DiaChiLamViec ?? "Toàn quốc")
                                </span>
                                <span class="me-3">
                                    <i class="far fa-clock text-primary me-1"></i>@(job.LoaiHinh ?? "Toàn thời gian")
                                </span>
                                <span class="text-danger fw-bold">
                                    <i class="far fa-money-bill-alt text-primary me-1"></i>
                                    @(job.LuongTu.HasValue ? $"{(job.LuongTu / 1000000):0.#} - {(job.LuongDen / 1000000):0.#} triệu" : "Thỏa thuận")
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="fa fa-user-tie me-1"></i>@(job.KinhNghiem ?? "Không yêu cầu kinh nghiệm")
                                </small>
                                <div>
                                    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.MaTin" class="btn btn-outline-info btn-sm me-1">
                                        <i class="fa fa-eye me-1"></i>Chi tiết
                                    </a>
                                    <button class="btn btn-primary btn-sm" onclick="openApplyModal(@job.MaTin)">
                                        <i class="fa fa-paper-plane me-1"></i>Ứng tuyển
                                    </button>
                                </div>
                            </div>
                            <div class="mt-2">
                                <small class="text-muted">
                                    <i class="far fa-calendar-alt me-1"></i>Hạn nộp: @(job.HanNop.HasValue ? job.HanNop.Value.ToString("dd/MM/yyyy") : "Không giới hạn")
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
