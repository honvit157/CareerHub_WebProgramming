@* TV5 - Chuông thông báo (AJAX). Chỉ hiện khi đã đăng nhập.
   Cách dùng: đặt  <partial name="~/Views/Notification/_Bell.cshtml" />  trong thanh menu của _Layout.cshtml.
   Không phụ thuộc jQuery/Bootstrap JS: tự bật/tắt dropdown bằng JavaScript thuần. *@
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="nav-item position-relative" id="notifBell">
        <a href="#" id="notifToggle" class="nav-link position-relative" aria-label="Thông báo" aria-expanded="false">
            <i class="bi bi-bell fs-5"></i>
            <span id="notifCount" class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle" style="display:none">0</span>
        </a>
        <div id="notifPanel" class="bg-white shadow border rounded position-absolute end-0" style="display:none; width:340px; max-width:90vw; z-index:1050;">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                <strong>Thông báo</strong>
                <button type="button" id="notifMarkAll" class="btn btn-link btn-sm p-0">Đánh dấu đã đọc</button>
            </div>
            <div id="notifItems" style="max-height:320px; overflow-y:auto;"></div>
            <div class="text-center border-top py-2">
                <a asp-controller="Notification" asp-action="Index">Xem tất cả</a>
            </div>
        </div>
        <form id="notifBellCsrf" class="d-none">@Html.AntiForgeryToken()</form>
    </div>

    <script>
        (function () {
            var urls = {
                latest: '@Url.Action("Latest", "Notification")',
                markAll: '@Url.Action("MarkAllRead", "Notification")',
                markOne: '@Url.Action("MarkRead", "Notification")'
            };
            var toggle = document.getElementById('notifToggle');
            var panel = document.getElementById('notifPanel');
            var countEl = document.getElementById('notifCount');
            var itemsEl = document.getElementById('notifItems');
            var token = document.querySelector('#notifBellCsrf input[name="__RequestVerificationToken"]').value;

            function setCount(n) {
                countEl.textContent = n > 99 ? '99+' : n;
                countEl.style.display = n > 0 ? '' : 'none';
            }
            window.updateNotifBell = setCount; // để trang khác (vd: /Notification) cập nhật chuông

            function post(url, extra) {
                var body = new FormData();
                body.append('__RequestVerificationToken', token);
                if (extra) Object.keys(extra).forEach(function (k) { body.append(k, extra[k]); });
                return fetch(url, { method: 'POST', body: body, credentials: 'same-origin' })
                    .then(function (r) { if (!r.ok) throw new Error(); return r.json(); });
            }

            function render(items) {
                itemsEl.textContent = '';
                if (!items.length) {
                    var empty = document.createElement('div');
                    empty.className = 'text-center text-muted p-3';
                    empty.textContent = 'Chưa có thông báo nào.';
                    itemsEl.appendChild(empty);
                    return;
                }
                items.forEach(function (n) {
                    var row = document.createElement('a');
                    row.href = '#';
                    row.className = 'd-block px-3 py-2 border-bottom text-decoration-none text-dark' + (n.isRead ? '' : ' bg-light');
                    var t = document.createElement('div');
                    t.className = n.isRead ? '' : 'fw-bold';
                    t.textContent = n.title;                // textContent: chống XSS
                    var c = document.createElement('small');
                    c.className = 'd-block text-muted';
                    c.textContent = n.content;
                    var d = document.createElement('small');
                    d.className = 'text-primary';
                    d.textContent = n.time || '';
                    row.appendChild(t); row.appendChild(c); row.appendChild(d);
                    row.addEventListener('click', function (e) {
                        e.preventDefault();
                        if (n.isRead) return;
                        post(urls.markOne, { id: n.id }).then(function (r) {
                            n.isRead = true;
                            row.classList.remove('bg-light'); t.classList.remove('fw-bold');
                            setCount(r.unreadCount);
                        }).catch(function () {});
                    });
                    itemsEl.appendChild(row);
                });
            }

            function load() {
                return fetch(urls.latest, { credentials: 'same-origin' })
                    .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                    .then(function (data) { setCount(data.unreadCount); render(data.items); })
                    .catch(function () {});
            }

            toggle.addEventListener('click', function (e) {
                e.preventDefault();
                var open = panel.style.display === 'none';
                panel.style.display = open ? '' : 'none';
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (open) load();
            });
            document.addEventListener('click', function (e) {
                if (!document.getElementById('notifBell').contains(e.target)) panel.style.display = 'none';
            });
            document.getElementById('notifMarkAll').addEventListener('click', function () {
                post(urls.markAll).then(function () { setCount(0); load(); }).catch(function () {});
            });

            load(); // lấy số thông báo chưa đọc ngay khi tải trang
        })();
    </script>
}