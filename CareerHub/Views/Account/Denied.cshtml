@{
    ViewData["Title"] = "Từ chối truy cập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl py-5">
    <div class="container text-center py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <i class="fa fa-exclamation-triangle fa-4x text-danger mb-4"></i>
                <h1 class="display-1 text-danger fw-bold">403</h1>
                <h2 class="mb-4">Từ chối truy cập!</h2>
                <p class="mb-4 text-muted fs-5">
                    Tài khoản của bạn không có quyền hạn để truy cập vào khu vực này. 
                    Trang này chỉ dành cho vai trò tương ứng (Nhà tuyển dụng hoặc Quản trị viên).
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary py-3 px-5">
                    <i class="fa fa-home me-2"></i>Quay về Trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
