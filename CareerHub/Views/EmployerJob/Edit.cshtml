@model CareerHub.ViewModels.JobFormVm
@{
    ViewData["Title"] = "Sửa tin tuyển dụng";
}

<div class="container-xxl py-5">
    <div class="container">
        <h1 class="text-center mb-5">Sửa tin tuyển dụng</h1>
        <form asp-action="Edit" asp-route-id="@Model.MaTin" method="post">
            <partial name="_JobForm" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-5">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-light">Quay lại</a>
            </div>
        </form>
    </div>
</div>
