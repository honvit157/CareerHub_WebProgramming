@model CareerHub.ViewModels.JobFormVm

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="MaTin" />

<div class="row g-3">
    <div class="col-12">
        <label asp-for="TieuDe" class="form-label"></label>
        <input asp-for="TieuDe" class="form-control" />
        <span asp-validation-for="TieuDe" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="MaDanhMuc" class="form-label"></label>
        <select asp-for="MaDanhMuc" asp-items="Model.Categories" class="form-select">
            <option value="">-- Chọn ngành nghề --</option>
        </select>
        <span asp-validation-for="MaDanhMuc" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="LoaiHinh" class="form-label"></label>
        <select asp-for="LoaiHinh" class="form-select">
            <option value="">-- Chọn loại hình --</option>
            @foreach (var t in CareerHub.ViewModels.JobFormVm.JobTypes)
            {
                <option value="@t" selected="@(Model.LoaiHinh == t)">@t</option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label asp-for="LuongTu" class="form-label"></label>
        <input asp-for="LuongTu" type="number" min="0" step="any" class="form-control" />
        <span asp-validation-for="LuongTu" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="LuongDen" class="form-label"></label>
        <input asp-for="LuongDen" type="number" min="0" step="any" class="form-control" />
        <span asp-validation-for="LuongDen" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="KinhNghiem" class="form-label"></label>
        <input asp-for="KinhNghiem" class="form-control" placeholder="vd: 2 năm" />
        <span asp-validation-for="KinhNghiem" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="DiaChiLamViec" class="form-label"></label>
        <input asp-for="DiaChiLamViec" class="form-control" />
        <span asp-validation-for="DiaChiLamViec" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="HanNop" class="form-label"></label>
        <input asp-for="HanNop" type="date" class="form-control" value="@Model.HanNop?.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="HanNop" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label class="form-label d-block">Kỹ năng yêu cầu</label>
        <div class="d-flex flex-wrap gap-3 border rounded p-3">
            @foreach (var k in Model.AllSkills)
            {
                var code = k.MaKyNang.Trim();
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedSkills" value="@code"
                           id="skill_@code" checked="@Model.SelectedSkills.Contains(code)" />
                    <label class="form-check-label" for="skill_@code">@k.TenKyNang</label>
                </div>
            }
        </div>
    </div>

    <div class="col-12">
        <label asp-for="MoTaCv" class="form-label"></label>
        <textarea asp-for="MoTaCv" rows="5" class="form-control"></textarea>
        <span asp-validation-for="MoTaCv" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="YeuCau" class="form-label"></label>
        <textarea asp-for="YeuCau" rows="4" class="form-control"></textarea>
    </div>
    <div class="col-12">
        <label asp-for="QuyenLoi" class="form-label"></label>
        <textarea asp-for="QuyenLoi" rows="4" class="form-control"></textarea>
    </div>
</div>
