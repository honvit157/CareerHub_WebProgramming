
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - CareerHub</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CareerHub - Tìm kiếm việc làm và cơ hội nghề nghiệp">

    <link href="~/Template/img/favicon.ico" rel="icon">

    <!-- Google Fonts -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap"
          rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css"
          rel="stylesheet">

    <!-- Libraries -->
    <link href="~/Template/lib/animate/animate.min.css"
          rel="stylesheet">

    <link href="~/Template/lib/owlcarousel/assets/owl.carousel.min.css"
          rel="stylesheet">

    <!-- Bootstrap -->
    <link href="~/Template/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- JobEntry CSS -->
    <link href="~/Template/css/style.css"
          asp-append-version="true"
          rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="container-xxl bg-white p-0">

        <!-- Spinner -->
        <div id="spinner"
             class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">

            <div class="spinner-border text-primary"
                 style="width:3rem;height:3rem;"
                 role="status">

                <span class="visually-hidden">
                    Loading...
                </span>
            </div>
        </div>

        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg bg-white navbar-light shadow sticky-top p-0">

            <a asp-controller="Home"
               asp-action="Index"
               class="navbar-brand d-flex align-items-center text-center py-0 px-4 px-lg-5">

                <h1 class="m-0 text-primary">
                    CareerHub
                </h1>
            </a>

            <button type="button"
                    class="navbar-toggler me-4"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarCollapse"
                    aria-controls="navbarCollapse"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto p-4 p-lg-0 align-items-center">
                    <a asp-controller="Home" asp-action="Index" class="nav-item nav-link active">Trang chủ</a>
                    <a asp-controller="Home" asp-action="FilterByCategory" class="nav-item nav-link">Việc theo ngành</a>

                    @* 1. NẾU NGƯỜI DÙNG ĐÃ ĐĂNG NHẬP THÀNH CÔNG *@
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @* Nếu là NHÀ TUYỂN DỤNG *@
                        @if (User.IsInRole("Nhà tuyển dụng"))
                        {
                            <a asp-controller="EmployerJob" asp-action="Index" class="nav-item nav-link">Quản lý tuyển dụng</a>
                        }
                        @* Nếu là ADMIN *@
                        else if (User.IsInRole("Quản trị viên"))
                        {
                            <a asp-controller="Admin" asp-action="Index" class="nav-item nav-link text-danger fw-bold">Quản trị Admin</a>
                        }

                        <!-- DROPDOWN MENU KHI BẤM VÀO TÊN NGƯỜI DÙNG -->
                        <div class="nav-item dropdown ms-2">
                            <a href="#" class="nav-link dropdown-toggle text-primary fw-bold d-flex align-items-center" data-bs-toggle="dropdown">
                                <i class="fa fa-user-circle fa-lg me-1 text-primary"></i>
                                <span>@User.Identity.Name</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end shadow border-0 m-0 rounded-3">
                                @if (User.IsInRole("Ứng viên"))
                                {
                                    <div class="dropdown-header text-muted small fw-bold text-uppercase">Hồ sơ & Ứng tuyển</div>
                                    <a asp-controller="Candidate" asp-action="Profile" class="dropdown-item py-2">
                                        <i class="fa fa-id-card me-2 text-primary"></i>Hồ sơ trực tuyến của tôi
                                    </a>
                                    <a asp-controller="Candidate" asp-action="MyCV" class="dropdown-item py-2">
                                        <i class="far fa-file-pdf me-2 text-info"></i>Quản lý file CV
                                    </a>
                                    <a asp-controller="Candidate" asp-action="MyApplications" class="dropdown-item py-2">
                                        <i class="fa fa-paper-plane me-2 text-success"></i>Lịch sử việc đã nộp
                                    </a>
                                    <a asp-controller="Candidate" asp-action="SavedJobs" class="dropdown-item py-2">
                                        <i class="fas fa-heart me-2 text-danger"></i>Việc làm đã lưu
                                    </a>
                                    <div class="dropdown-divider"></div>
                                }
                                
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 py-1">
                                    <button type="submit" class="dropdown-item text-danger rounded py-2">
                                        <i class="fa fa-sign-out-alt me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    @* 2. NẾU CHƯA ĐĂNG NHẬP (KHÁCH VÃNG LAI) *@
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="nav-item nav-link">Đăng nhập</a>
                        <a asp-controller="Account" asp-action="Register" class="nav-item nav-link">Đăng ký</a>
                    }
                </div>
                <partial name="~/Views/Notification/_Bell.cshtml" />
                <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary rounded-0 py-4 px-lg-5 d-none d-lg-block">Tìm việc làm<i class="fa fa-arrow-right ms-3"></i></a>
            </div>
        </nav>
        <!-- Navbar End -->

        <!-- Page Content -->
        <main>
            @RenderBody()
        </main>
        <!-- Page Content End -->

        <!-- Footer -->
        <div id="footer"
             class="container-fluid bg-dark text-white-50 footer pt-5 mt-5 wow fadeIn"
             data-wow-delay="0.1s">

            <div class="container py-5">

                <div class="row g-5">

                    <!-- Company -->
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">CareerHub</h5>
                        <p>Tìm việc làm phù hợp và xây dựng tương lai sự nghiệp của bạn.</p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-link text-white-50">Trang chủ</a>
                        <a asp-controller="Jobs" asp-action="Index" class="btn btn-link text-white-50">Tìm việc làm</a>
                        <a asp-controller="Home" asp-action="FilterByCategory" class="btn btn-link text-white-50">Việc theo ngành</a>
                    </div>

                    <!-- Quick Links -->
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Liên kết nhanh</h5>
                        <a asp-controller="Jobs" asp-action="Index" class="btn btn-link text-white-50">Danh sách việc làm</a>
                        <a asp-controller="Home" asp-action="FilterByCategory" class="btn btn-link text-white-50">Việc theo ngành</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-link text-white-50">Đăng nhập</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-link text-white-50">Đăng ký</a>
                    </div>

                    <!-- Contact -->
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Liên hệ</h5>
                        <p>Kết nối với CareerHub để tìm kiếm cơ hội việc làm tốt nhất.</p>

                        <div class="d-flex pt-2">

                            <a class="btn btn-outline-light btn-social"
                               href="https://www.facebook.com/"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="Facebook">
                                <i class="fab fa-facebook-f"></i>
                            </a>

                            <a class="btn btn-outline-light btn-social"
                               href="https://www.linkedin.com/"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="LinkedIn">
                                <i class="fab fa-linkedin-in"></i>
                            </a>

                        </div>

                    </div>

                    <!-- Newsletter -->
                    <div class="col-lg-3 col-md-6">

                        <h5 class="text-white mb-4">
                            Newsletter
                        </h5>

                        <p>
                            Explore new job opportunities
                            with CareerHub.
                        </p>

                        <a asp-controller="Jobs"
                           asp-action="Index"
                           class="btn btn-primary">
                            Explore Jobs
                        </a>

                    </div>

                </div>
            </div>

            <div class="container">

                <div class="copyright">

                    <div class="row">

                        <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">

                            &copy; CareerHub.
                            All Rights Reserved.

                            <br />

                            Designed By
                            <a class="border-bottom"
                               href="https://htmlcodex.com">
                                HTML Codex
                            </a>

                            <br />

                            Distributed By
                            <a class="border-bottom"
                               href="https://themewagon.com"
                               target="_blank"
                               rel="noopener noreferrer">
                                ThemeWagon
                            </a>

                        </div>

                        <div class="col-md-6 text-center text-md-end">

                            <div class="footer-menu">

                                <a asp-controller="Home"
                                   asp-action="Index">
                                    Home
                                </a>

                                <a asp-controller="Jobs"
                                   asp-action="Index">
                                    Jobs
                                </a>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- Footer End -->

        <!-- Back to Top -->
        <a href="#"
           class="btn btn-lg btn-primary btn-lg-square back-to-top"
           aria-label="Back to top">

            <i class="bi bi-arrow-up"></i>
        </a>

    </div>

<!-- JavaScript Libraries -->
<script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/Template/lib/wow/wow.min.js"></script>
<script src="~/Template/lib/easing/easing.min.js"></script>
<script src="~/Template/lib/waypoints/waypoints.min.js"></script>
<script src="~/Template/lib/owlcarousel/owl.carousel.min.js"></script>

<!-- Template Javascript -->
<script src="~/Template/js/main.js"></script>
@await RenderSectionAsync("Scripts", required: false)
    <!-- Chỗ chứa chiếc Popup Ứng tuyển -->
    <div id="applyModalContainer"></div>

    <!-- Script gọi AJAX để mở Popup ứng tuyển -->
    <script>
        function openApplyModal(maTin) {
            @if (User.Identity == null || !User.Identity.IsAuthenticated)
            {
                <text>
                    alert("Vui lòng đăng nhập tài khoản Ứng viên để ứng tuyển công việc này!");
                    window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                    return;
                </text>
            }

            $.ajax({
                url: '/Candidate/GetApplyModal?maTin=' + maTin,
                type: 'GET',
                success: function (html) {
                    $('#applyModalContainer').html(html);
                    if (window.bootstrap && bootstrap.Modal) {
                        var myModal = new bootstrap.Modal(document.getElementById('applyJobModal'));
                        myModal.show();
                    } else {
                        $('#applyJobModal').modal('show');
                    }
                },
                error: function (xhr) {
                    alert("Có lỗi xảy ra: " + (xhr.responseText || "Không thể tải mẫu ứng tuyển!"));
                }
            });
        }
    </script>
</body>
</html>
