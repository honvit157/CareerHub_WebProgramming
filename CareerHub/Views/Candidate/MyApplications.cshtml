@model IEnumerable<CareerHub.Models.Ungtuyen>

@{
    ViewData["Title"] = "Việc làm đã ứng tuyển";
}

<div class="container my-5">
    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="fa fa-briefcase me-2"></i>Lịch Sử Ứng Tuyển Của Tôi
            </h3>
            <p class="text-muted mb-0">Theo dõi tiến độ xét duyệt hồ sơ từ các nhà tuyển dụng</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
            <i class="fa fa-search me-1"></i>Tìm việc làm khác
        </a>
    </div>

    <!-- Thông báo thành công hoặc lỗi nếu có -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bảng danh sách các việc làm đã nộp -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <img src="~/Template/img/com-logo-1.jpg" alt="" class="mb-3 rounded-circle" style="width: 70px; opacity: 0.5;">
                    <h5 class="text-muted fw-normal">Bạn chưa nộp hồ sơ ứng tuyển vào công việc nào.</h5>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
                        Khám phá việc làm ngay
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Vị trí công việc</th>
                                <th>Công ty</th>
                                <th>CV đã nộp</th>
                                <th>Ngày nộp</th>
                                <th>Trạng thái xét duyệt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Tên công việc -->
                                    <td class="ps-4">
                                        <span class="fw-bold text-dark d-block">
                                            @(item.MaTinNavigation?.TieuDe ?? "Công việc không xác định")
                                        </span>
                                        <small class="text-muted">
                                            <i class="fa fa-map-marker-alt me-1"></i>@(item.MaTinNavigation?.DiaChiLamViec ?? "Toàn quốc")
                                        </small>
                                    </td>

                                    <!-- Tên công ty tuyển dụng -->
                                    <td>
                                        <span class="fw-semibold text-primary">
                                            @(item.MaTinNavigation?.MaCongTyNavigation?.TenCongTy ?? "Chưa cập nhật")
                                        </span>
                                    </td>

                                    <!-- CV đã nộp -->
                                    <td>
                                        <span class="d-block text-secondary">
                                            <i class="fa fa-file-pdf me-1 text-danger"></i>@(item.MaCvNavigation?.TenCv ?? "Hồ sơ đính kèm")
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.MaCvNavigation?.DuongDanFile))
                                        {
                                            <a href="@item.MaCvNavigation.DuongDanFile" target="_blank" class="small text-decoration-underline text-info">
                                                Xem lại file CV
                                            </a>
                                        }
                                    </td>

                                    <!-- Ngày nộp đơn -->
                                    <td>
                                        <small class="text-muted">
                                            @(item.NgayNop?.ToString("dd/MM/yyyy HH:mm") ?? "Hôm nay")
                                        </small>
                                    </td>

                                    <!-- Trạng thái xét duyệt -->
                                    <td>
                                        @if (item.TrangThai == "Đang chờ duyệt")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                                <i class="far fa-clock me-1"></i>Đang chờ duyệt
                                            </span>
                                        }
                                        else if (item.TrangThai == "Đã duyệt" || item.TrangThai == "Trúng tuyển")
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                                <i class="fa fa-check me-1"></i>@item.TrangThai
                                            </span>
                                        }
                                        else if (item.TrangThai == "Từ chối")
                                        {
                                            <span class="badge bg-danger px-3 py-2 rounded-pill">
                                                <i class="fa fa-times me-1"></i>Từ chối
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                                @(item.TrangThai ?? "Đang xét duyệt")
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>