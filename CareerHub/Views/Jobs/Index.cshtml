@model List<CareerHub.Models.Tintuyendung>
@using System.Globalization

@{
    ViewData["Title"] = "Tìm kiếm việc làm";
    int currentPage = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalJobs = ViewBag.TotalJobs ?? 0;
    string keyword = ViewBag.Keyword as string ?? "";
    string categoryId = ViewBag.CategoryId as string ?? "";
    string location = ViewBag.Location as string ?? "";
    string minSalary = Convert.ToString(ViewBag.MinSalary, CultureInfo.InvariantCulture) ?? "";
    string maxSalary = Convert.ToString(ViewBag.MaxSalary, CultureInfo.InvariantCulture) ?? "";
    string[] selectedWorkTypes = ViewBag.WorkType as string[] ?? Array.Empty<string>();

    string PageUrl(int pageNumber)
    {
        var query = new List<KeyValuePair<string, string>>();
        if (!string.IsNullOrWhiteSpace(keyword)) query.Add(new("keyword", keyword));
        if (!string.IsNullOrWhiteSpace(categoryId)) query.Add(new("categoryId", categoryId));
        if (!string.IsNullOrWhiteSpace(location)) query.Add(new("location", location));
        if (!string.IsNullOrWhiteSpace(minSalary)) query.Add(new("minSalary", minSalary));
        if (!string.IsNullOrWhiteSpace(maxSalary)) query.Add(new("maxSalary", maxSalary));
        foreach (var type in selectedWorkTypes) query.Add(new("workType", type));
        query.Add(new("page", pageNumber.ToString()));
        return (Url.Action("Index", "Jobs") ?? "/Jobs/Index") + "?" +
            string.Join("&", query.Select(x => Uri.EscapeDataString(x.Key) + "=" + Uri.EscapeDataString(x.Value)));
    }
}

<!-- Page Header Start -->
<div class="container-fluid bg-primary mb-5">
    <div class="container py-5">
        <h1 class="display-5 text-white mb-3">Tìm Kiếm Việc Làm</h1>
        <p class="text-white mb-0">Khám phá hàng ngàn cơ hội nghề nghiệp phù hợp với năng lực của bạn tại CareerHub.</p>
    </div>
</div>
<!-- Page Header End -->

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Filters -->
            <div class="col-lg-3">
                <div class="job-filter-card bg-light rounded p-4">
                    <h5 class="mb-4"><i class="fa fa-filter me-2 text-primary"></i>Bộ Lọc Tìm Kiếm</h5>
                    <form id="jobSearchForm" method="get" asp-controller="Jobs" asp-action="Index">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Từ khóa</label>
                            <input type="text" name="keyword" class="form-control"
                                   placeholder="Tên công việc hoặc công ty..." value="@keyword" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ngành nghề</label>
                            <select name="categoryId" class="form-select">
                                <option value="">Tất cả ngành nghề</option>
                                <option value="IT01" selected="@(categoryId == "IT01")">Công nghệ thông tin</option>
                                <option value="MK01" selected="@(categoryId == "MK01")">Marketing &amp; SEO</option>
                                <option value="TC01" selected="@(categoryId == "TC01")">Tài chính &amp; Kế toán</option>
                                <option value="NS01" selected="@(categoryId == "NS01")">Nhân sự &amp; Hành chính</option>
                                <option value="KD01" selected="@(categoryId == "KD01")">Kinh doanh &amp; Bán hàng</option>
                                <option value="DH01" selected="@(categoryId == "DH01")">Thiết kế &amp; Đồ họa</option>
                                <option value="XD01" selected="@(categoryId == "XD01")">Xây dựng &amp; Kiến trúc</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Địa điểm</label>
                            <select name="location" class="form-select">
                                <option value="">Tất cả địa điểm</option>
                                <option value="Hà Nội" selected="@(location == "Hà Nội")">Hà Nội</option>
                                <option value="Sài Gòn" selected="@(location == "Sài Gòn")">TP. Hồ Chí Minh</option>
                                <option value="Đà Nẵng" selected="@(location == "Đà Nẵng")">Đà Nẵng</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mức lương tối thiểu (VNĐ)</label>
                            <input type="number" min="0" name="minSalary" class="form-control"
                                   placeholder="VD: 10000000" value="@minSalary" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mức lương tối đa (VNĐ)</label>
                            <input type="number" min="0" name="maxSalary" class="form-control"
                                   placeholder="VD: 30000000" value="@maxSalary" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold d-block">Hình thức làm việc</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workType" value="Full-time"
                                       id="fulltime" checked="@(selectedWorkTypes.Contains("Full-time"))" />
                                <label class="form-check-label" for="fulltime">Toàn thời gian (Full-time)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workType" value="Part-time"
                                       id="parttime" checked="@(selectedWorkTypes.Contains("Part-time"))" />
                                <label class="form-check-label" for="parttime">Bán thời gian (Part-time)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workType" value="Internship"
                                       id="intern" checked="@(selectedWorkTypes.Contains("Internship"))" />
                                <label class="form-check-label" for="intern">Thực tập sinh (Internship)</label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Áp dụng bộ lọc</button>
                        <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Xóa bộ lọc</a>
                    </form>
                </div>
            </div>

            <!-- Job listing -->
            <div class="col-lg-9">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Danh Sách Việc Làm</h3>
                        <span id="jobCount" class="text-muted">Tìm thấy @totalJobs việc làm phù hợp</span>
                    </div>
                </div>

                <div id="jobList">
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var job in Model)
                        {
                            <div class="job-item p-4 mb-4 border rounded shadow-sm bg-white">
                                <div class="row g-4">
                                    <div class="col-sm-12 col-md-8 d-flex align-items-center">
                                        <div class="text-start">
                                            <h5 class="mb-2">
                                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.MaTin" class="text-primary fw-bold">@job.TieuDe</a>
                                            </h5>
                                            <span class="d-block mb-2 text-muted fw-semibold">
                                                <i class="fa fa-building me-1"></i>@(job.MaCongTyNavigation?.TenCongTy ?? "Chưa cập nhật")
                                            </span>
                                            <span class="text-truncate me-3 text-muted">
                                                <i class="fa fa-map-marker-alt text-primary me-1"></i>@(job.DiaChiLamViec ?? "Toàn quốc")
                                            </span>
                                            <span class="text-truncate me-3 text-muted">
                                                <i class="far fa-clock text-primary me-1"></i>@(job.LoaiHinh ?? "Toàn thời gian")
                                            </span>
                                            <span class="text-truncate text-danger fw-bold">
                                                <i class="far fa-money-bill-alt text-primary me-1"></i>
                                                @(job.LuongTu.HasValue ? $"{(job.LuongTu / 1000000):0.#} - {(job.LuongDen / 1000000):0.#} triệu" : "Thỏa thuận")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-4 d-flex flex-column align-items-start align-items-md-end justify-content-center">
                                        <div class="mb-3">
                                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.MaTin" class="btn btn-outline-info btn-sm me-1">Chi tiết</a>
                                            <button class="btn btn-primary btn-sm" onclick="openApplyModal(@job.MaTin)">
                                                <i class="fa fa-paper-plane me-1"></i>Ứng tuyển
                                            </button>
                                        </div>
                                        <small class="text-muted">
                                            <i class="far fa-calendar-alt text-primary me-1"></i>
                                            Hạn nộp: @(job.HanNop?.ToString("dd/MM/yyyy") ?? "Không giới hạn")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info text-center py-4">
                            <i class="fa fa-info-circle me-2"></i>Không tìm thấy việc làm nào phù hợp với điều kiện tìm kiếm của bạn.
                        </div>
                    }
                </div>

                <div id="jobPagination">
                    @if (totalPages > 1)
                    {
                        <nav aria-label="Job pagination">
                            <ul class="pagination justify-content-center mt-4">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(Math.Max(1, currentPage - 1))">Trước</a>
                                </li>
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="@PageUrl(i)">@i</a>
                                    </li>
                                }
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(Math.Min(totalPages, currentPage + 1))">Sau</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/jobs.js" asp-append-version="true"></script>
}
