@model CareerHub.Models.Danhmuc

@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="container py-4">

    <h2 class="mb-4">Sửa danh mục nghề nghiệp</h2>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MaDanhMuc" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="MaDanhMuc" class="form-label">
                        Mã danh mục
                    </label>

                    <input asp-for="MaDanhMuc"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="TenDanhMuc" class="form-label">
                        Tên danh mục
                    </label>

                    <input asp-for="TenDanhMuc"
                           class="form-control" />

                    <span asp-validation-for="TenDanhMuc"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label">
                        Mô tả
                    </label>

                    <textarea asp-for="MoTa"
                              class="form-control"
                              rows="4">
                    </textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    Lưu thay đổi
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>

            </form>

        </div>

    </div>

</div>